---
/**
 * The twelve weeks, one card each. A card is the whole week now — the lecture,
 * the lab it pairs with, and a direct link to that week's slides — so all
 * twelve decks are one click from the Lecture tab rather than two.
 *
 * Not built on the theme's `Card`, which is why this hand-rolls `.at-card`.
 * `Card` renders the entire card as a single `<a>` when given an `href`, so a
 * second link inside the slot is an anchor nested in an anchor: the parser
 * splits it, and axe fails the page with `link-name — Ensure links have
 * discernible text`. Two destinations per card means two sibling links, so the
 * card is a plain `<article>` wearing the theme's card class and the heading
 * carries the link instead of the container.
 */
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";
import { WEEKS_WITH_DIAGRAM } from "../lib/week-diagrams";
import { sessionLabels } from "../site-config";

const [lectures, sessions] = await Promise.all([
  getPublishedCollection("lectures"),
  getPublishedCollection("sessions"),
]);
const labByWeek = new Map(sessions.map((s) => [Number(s.data.week), s]));
const weeks = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const labWord = sessionLabels.singular.toLowerCase();
---

<CardGrid columns={2}>
  {
    weeks.map((lecture) => {
      const lab = labByWeek.get(Number(lecture.data.week));
      return (
        <article class="at-card week-card">
          <div class="at-card-body">
            <h2 class="at-card-title">
              <a href={withBase(`/lectures/${lecture.id}/`)}>
                Week {lecture.data.week}: {lecture.data.title}
              </a>
            </h2>
            {WEEKS_WITH_DIAGRAM.has(Number(lecture.data.week)) && (
              <p class="at-card-badges">
                <span class="at-card-badge">Interactive diagram</span>
              </p>
            )}
            {lecture.data.description && <p>{lecture.data.description}</p>}
            {lab && (
              <p class="week-card-lab">
                <strong>{labWord}:</strong> {lab.data.title}
              </p>
            )}
            <p class="week-card-foot">
              <small>{formatCourseDate(lecture.data.date)}</small>
              {lecture.data.slides && (
                <a href={withBase(lecture.data.slides)}>
                  Slides<span class="at-visually-hidden"> for week {lecture.data.week}</span>
                </a>
              )}
            </p>
          </div>
        </article>
      );
    })
  }
</CardGrid>

<style>
  .week-card-lab {
    color: var(--at-text-secondary);
  }

  .week-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-block-end: 0;
  }

  /* Twelve cards means twelve links reading "Slides" to anyone listing a page's
     links out of context. The week number is there but not shown. */
  .at-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
