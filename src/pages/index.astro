---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import Icon from "astro-theme-university/components/Icon.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import heroImage from "../assets/images/hero-home.svg";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="Three shelves of bottles, cans and cask-wine boxes reduced to flat gold and black silhouettes, with small price tags below them, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2><Icon name="home-simple" size="1.2em" style="vertical-align: -0.15em; margin-inline-end: 0.4rem;" /> Welcome</h2>
  <p class="lede">
    The Australian supermarket liquor aisle is not a random assortment of
    beverages; it is highly designed to obscure taxation penalties and
    maximize retail margins. Welcome to SLOP4230. This course treats the
    standard alcholic drink not as a public health guideline, but as a
    foundational economic currency.
  </p>

  <h2><Icon name="compass" size="1.2em" style="vertical-align: -0.15em; margin-inline-end: 0.4rem;" /> What you will do</h2>
  <p>
This course utilizes the retail liquor sector as a primary dataset for interdisciplinary empirical analysis. Grounded in peer-reviewed literature, weekly modules examine the chemical, fiscal, and spatial dimensions of alcohol retail, ranging from fermentation economics and behavioral merchandising to the structural incentives of the Wine Equalisation Tax.
  </p>

  <h2><Icon name="group" size="1.2em" style="vertical-align: -0.15em; margin-inline-end: 0.4rem;" /> Who it is for</h2>
  <p>
    This course is designed for students interested in the empirical realities underlying retail pricing. It assumes no prior background in economics, data science, or tax law, requiring only a willingness to critically evaluate market data. While the research context is unconventional, the analytical methodology demands strict academic rigor and engagement.
  </p>

  <h2><Icon name="arrow-up-right" size="1.2em" style="vertical-align: -0.15em; margin-inline-end: 0.4rem;" /> Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Lecture" href="/lectures/">
      <p>
        Twelve weeks. Each page carries that week's argument, its {
          sessionLabels.singular.toLowerCase()
        } and its slides.
      </p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="Toolkit" href="/toolkit/">
      <p>The index, the two tax regimes, and the constrained selection.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .lede {
    font-size: 1.1rem;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
